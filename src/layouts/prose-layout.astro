---
import { Image } from "astro:assets";

// import Back from "~icons/mdi/arrow-left";
// import Tweet from "~icons/mdi/twitter";

import Button from "@/components/Button.astro";
import Prose from "@/components/Prose.astro";
import OriginallyPosted from "@/components/OriginallyPosted.astro";

import PageLayout from "./page-layout.astro";

export type Props = {
  title: string;
  subtitle: string;
  image?: ImageMetadata;
  original?: string;
  showHero?: boolean;
};

const { title, subtitle, image, original, showHero } = Astro.props;

function getShareURL() {
  const url = Astro.url.toString();
  const tweet = `An absolutely lovely read by @tylernickerson: ${url}`;
  return `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweet)}`;
}
---

<PageLayout
  type="article"
  title={title}
  description={subtitle}
  image={{ src: image, alt: title }}
>
  <!-- <nav
    class="bg-gray-0/75 lg:bg-clear fixed top-0 z-50 flex w-full flex-row items-center justify-between p-4 backdrop-blur-lg lg:backdrop-blur-none dark:bg-gray-900/75"
  >
    <Button variant="secondary" title="Back" href="/" icon={Back} />
    <Button
      variant="secondary"
      href={getShareURL()}
      title="Share"
      icon={Tweet}
    />
  </nav> -->

  {
    image && showHero && (
      <div class="cover animate-fade-up container mx-auto px-8 lg:mb-16">
        <Image densities={[1, 2, 3]} quality="high" alt="" src={image} />{" "}
      </div>
    )
  }

  <article
    class="animate-fade-up container mx-auto grid w-full grid-cols-1 items-center p-8 lg:grid-cols-[1fr_var(--breakpoint-sm)_1fr]"
    class:list={[{ "mt-16": !image || !showHero }]}
  >
    <header class="flex flex-col items-start py-2 lg:col-start-2">
      <slot name="label" />
      <h1 class="mt-3">
        {title}
      </h1>
      <p class="text-secondary-foreground m-0 font-sans text-base">
        {subtitle}
      </p>
      {
        Astro.slots.has("tags") && (
          <div class="flex flex-row items-center justify-center gap-4">
            <slot name="tags" />
          </div>
        )
      }
    </header>

    <hr class="col-start-2 mb-6" />

    <aside
      class="not-prose sticky top-32 col-start-1 hidden self-start justify-self-end text-right lg:block"
    >
      <slot name="toc" />
    </aside>

    <div class="prose-wrapper lg:col-start-2">
      <Prose>
        <slot />
        <hr class="my-8 w-full border lg:col-start-2" />
        {original && <OriginallyPosted original={original} />}
      </Prose>
    </div>
  </article>
</PageLayout>
