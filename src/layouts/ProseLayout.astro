---
import { Image } from "astro:assets";
import OriginallyPosted from "@/components/OriginallyPosted.astro";
import Prose from "@/components/Prose.astro";
import Button from "@/components/ui/Button.astro";
import Separator from "@/components/ui/Separator.astro";
import { RoundAltArrowLeftBold } from "@/lib/icons";
import { cn } from "@/lib/utils";
import Back from "~icons/mdi/arrow-left";
import Tweet from "~icons/mdi/twitter";
import BaseLayout from "./BaseLayout.astro";
export type Props = {
  title: string;
  subtitle: string;
  image?: ImageMetadata;
  original?: string;
};

const { title, subtitle, image, original } = Astro.props;

function getShareURL() {
  const url = Astro.url.toString();
  const tweet = `An absolutely lovely read by @tylernickerson: ${url}`;
  return `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweet)}`;
}
---

<BaseLayout
  type="article"
  title={title}
  description={subtitle}
  image={image?.src}
>
  <nav
    class="flex top-4 z-50 fixed p-4 w-full justify-between items-center flex-row bg-gray-0 bg-opacity-75 backdrop-blur-lg lg:bg-clear lg:backdrop-blur-none"
  >
    <Button variant="link" size="icon" title="Back" href="/">
      <RoundAltArrowLeftBold class="size-8" />
    </Button>
    <Button
      variant="secondary"
      href={getShareURL()}
      title="Share"
      icon={Tweet}
    />
  </nav>

  <article
    class:list={cn([
      "items-center mx-auto w-full grid container gap-x-1 lg:grid-cols-[10rem_1fr_10rem] grid-cols-1 animate-fade-up",
    ])}
  >
    <header class="py-8 flex flex-col items-start text-left lg:col-start-2">
      <h1 class="py-2 m-0 leading-tight text-pretty">
        {title}
      </h1>

      <div class="text-xl leading-normal text-muted-foreground">
        {subtitle}
      </div>

      <slot name="byline">
        <Separator class="lg:col-start-2 my-6" />
      </slot>
    </header>

    {
      image && (
        <Image
          class="lg:h-112 lg:col-start-1 lg:col-span-full mb-18 mt-10 object-cover object-top rounded-lg shadow-md"
          layout="constrained"
          quality="high"
          alt=""
          src={image}
        />
      )
    }

    <aside
      class="not-prose col-start-1 lg:block hidden sticky text-right justify-self-end self-start top-32"
    >
      <slot name="toc" />
    </aside>

    <Prose class="lg:col-start-2">
      <slot />
      <Separator />
      {original && <OriginallyPosted original={original} />}
    </Prose>
  </article>
</BaseLayout>

