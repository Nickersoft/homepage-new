---
import { Image } from "astro:assets";
import OriginallyPosted from "@/components/OriginallyPosted.astro";
import Prose from "@/components/Prose.astro";
import Button from "@/components/ui/Button.astro";
import Separator from "@/components/ui/Separator.astro";
import Typography from "@/components/ui/Typography.astro";
import { RoundAltArrowLeftBold } from "@/lib/icons";
import { cn } from "@/lib/utils";
import Back from "~icons/mdi/arrow-left";
import Tweet from "~icons/mdi/twitter";
import BaseLayout from "./BaseLayout.astro";
export type Props = {
  title: string;
  subtitle: string;
  image?: ImageMetadata;
  original?: string;
  showHero?: boolean;
};

const { title, subtitle, image, original, showHero } = Astro.props;

function getShareURL() {
  const url = Astro.url.toString();
  const tweet = `An absolutely lovely read by @tylernickerson: ${url}`;
  return `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweet)}`;
}
---

<BaseLayout
  type="article"
  title={title}
  description={subtitle}
  image={image?.src}
>
  <nav
    class="flex top-0 z-50 fixed p-4 w-full justify-between items-center flex-row bg-gray-0 bg-opacity-75 dark:bg-opacity-75 backdrop-blur-lg lg:bg-clear lg:backdrop-blur-none"
  >
    <Button variant="link" size="icon" title="Back" href="/">
      <RoundAltArrowLeftBold class="size-8" />
    </Button>
    <Button
      variant="secondary"
      href={getShareURL()}
      title="Share"
      icon={Tweet}
    />
  </nav>

  {
    image && showHero && (
      <div class="lg:mb-16 container mx-auto px-8 animate-fade-up">
        <Image
          class="lg:h-112 mt-18 object-cover object-top rounded-lg dark:shadow-none shadow-md"
          densities={[1, 2, 3]}
          quality="high"
          alt=""
          src={image}
        />{" "}
      </div>
    )
  }

  <article
    class:list={cn([
      "items-center mx-auto w-full grid container gap-x-1 lg:grid-cols-[1fr_48rem_1fr] grid-cols-1 animate-fade-up",
      { "mt-16": !image || !showHero },
    ])}
  >
    <header class="py-2 flex flex-col items-start text-left lg:col-start-2">
      <Typography variant="display" size="lg" class="py-2 text-pretty">
        {title}
      </Typography>
      <Typography variant="body" size="lg" color="muted">
        {subtitle}
      </Typography>
      <slot name="tags" />
    </header>

    <Separator class="lg:col-start-1" />

    <aside
      class="not-prose col-start-1 lg:block hidden sticky text-right justify-self-end self-start top-32"
    >
      <slot name="toc" />
    </aside>

    <div class="lg:col-start-2">
      <Prose>
        <slot />
        <Separator />
        {original && <OriginallyPosted original={original} />}
      </Prose>
    </div>
  </article>
</BaseLayout>

