---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import Pill from "@/components/ui/Pill.astro";

const posts = (await getCollection("caseStudy")).sort(
  (a, b) => b.data.year.valueOf() - a.data.year.valueOf(),
);
---

<ul class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4 w-full">
  {
    posts.map(({ slug, data: { year, title, roles, image } }) => (
      <li class="transform-3d perspective-dramatic">
        <a
          class="relative w-full group hover:-translate-y-1 transition-all duration-300 border border-white/60 ring ring-foreground/8 flex gap-6 hover:bg-accent p-0 rounded-2xl overflow-hidden shadow-md aspect-[1.6] flex-col justify-end"
          data-astro-prefetch="none"
          href={`/portfolio/${slug}/`}
        >
          <div class="flex backdrop-blur-lg p-4 bg-gradient-to-br from-card/50 via-card/80 to-card/60 border-t border-white/80 relative z-40 py-3 flex-col gap-1">
            <small class="text-muted-foreground">{year}</small>
            <h4>{title}</h4>
            <div class="flex flex-row justify-start items-center gap-2 mt-4">
              {roles.map((role) => (
                <Pill variant="filled">{role}</Pill>
              ))}
            </div>
          </div>

          <Image
            layout="full-width"
            class="absolute inset-0 transition-all duration-300 object-cover size-full"
            alt={title}
            src={image}
          />
        </a>
      </li>
    ))
  }
</ul>
