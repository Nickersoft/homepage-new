---
// import OpenInNew from "~icons/mdi/open-in-new";

export type Props = {
  original: string;
};

const { original } = Astro.props;
---

<div class="notice text-muted-foreground text-center text-sm">
  This article was originally published on{" "}
  <a
    class="inline-flex flex-row items-center justify-center gap-0.5"
    href={original}
    target="_blank"
    rel="noreferrer noopener"
  >
    {new URL(original).hostname}
    {/* <OpenInNew class="w-3 h-3" /> */}
  </a>{" "}
  and has been posted above for convenience.
</div>

<style lang="postcss">
  @reference "../styles/global.css";

  .notice {
  }
</style>
