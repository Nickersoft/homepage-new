---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Pill from "./Pill.astro";
import ProgressiveBlur from "./ui/ProgressiveBlur.astro";
import Typography from "./ui/Typography.astro";

export type Props = {
  item: CollectionEntry<"caseStudy">;
};

const {
  item: {
    data: { roles, image, title, year, description },
    slug,
  },
} = Astro.props;
---

<a
  class="relative w-full group hover:-translate-y-1 transition-all duration-300 border border-white/60 ring ring-foreground/8 flex gap-6 hover:bg-accent p-0 rounded-2xl overflow-hidden shadow-md aspect-[1.6] flex-col justify-end"
  data-astro-prefetch="none"
  href={`/portfolio/${slug}/`}
>
  <div
    class="flex backdrop-blur-lg p-4 bg-gradient-to-br from-card/50 via-card/80 to-card/60 border-t border-white/80 relative z-40 py-3 flex-col gap-1"
  >
    <span
      class="tracking-widest ml-1 text-muted-foreground text-xs m-0 font-medium"
    >
      {year}
    </span>
    <Typography variant="title" size="lg">{title}</Typography>
    <div class="flex flex-row justify-start items-center gap-2 mt-4">
      {
        roles.map((role) => (
          <Pill size="sm" variant="filled">
            {role}
          </Pill>
        ))
      }
    </div>
  </div>

  <Image
    layout="full-width"
    class="absolute inset-0 transition-all duration-300 object-cover size-full"
    alt={title}
    src={image}
  />
</a>
