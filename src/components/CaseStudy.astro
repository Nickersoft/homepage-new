---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Pill from "./Pill.astro";

export type Props = {
  item: CollectionEntry<"caseStudy">;
};

const {
  item: {
    data: { roles, image, title, year, description },
    slug,
  },
} = Astro.props;
---

<a
  class="relative w-full flex gap-6 hover:bg-accent p-4 rounded-2xl overflow-hidden shadow-md aspect-[1.6] flex-col justify-end transition-colors duration-300"
  data-astro-prefetch="none"
  href={`/portfolio/${slug}/`}
>
  <Image
    layout="full-width"
    class="absolute inset-0 object-cover size-full"
    alt={title}
    src={image}
  />
  <div class="flex relative z-20 py-3 flex-col gap-1">
    <span
      class="tracking-widest ml-1 text-muted-foreground text-xs m-0 font-medium"
    >
      {year}
    </span>
    <h3 class="font-medium ml-1">{title}</h3>
    <div class="flex flex-row justify-start items-center gap-2 mt-4">
      {
        roles.map((role) => (
          <Pill size="sm" variant="filled">
            {role}
          </Pill>
        ))
      }
    </div>
  </div>
</a>
