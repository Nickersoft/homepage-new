---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Pill from "./Pill.astro";

export type Props = {
  item: CollectionEntry<"caseStudy">;
};

const {
  item: {
    data: { roles, image, title, year, description },
    slug,
  },
} = Astro.props;
---

<a
  class="rounded-3xl relative aspect-[1.2] shadow-md bg-gradient-to-b from-card to-background p-0 ring-1 ring-white/20! overflow-hidden h-full flex flex-col justify-end transition-colors duration-300"
  data-astro-prefetch="hover"
  href={`/portfolio/${slug}/`}
>
  <Image
    class="absolute inset-0 size-full object-cover"
    layout="full-width"
    alt={title}
    src={image}
  />
  <div
    class="flex border-t border-t-white/50! shadow-[0_0px_12px] shadow-black/10 bg-gradient-to-br from-card/95 to-card/80 relative z-20 backdrop-blur-xl flex-col gap-1 mt-4 p-4"
  >
    <span
      class="tracking-widest ml-1 text-muted-foreground text-xs m-0 font-medium"
    >
      {year}
    </span>
    <h3 class="font-medium ml-1">{title}</h3>
    <div class="flex flex-row justify-start items-center gap-2 mt-4">
      {
        roles.map((role) => (
          <Pill size="sm" variant="filled">
            {role}
          </Pill>
        ))
      }
    </div>
  </div>
</a>
