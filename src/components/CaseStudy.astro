---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Pill from "./Pill.astro";

export type Props = {
  item: CollectionEntry<"caseStudy">;
};

const {
  item: {
    data: { roles, image, title, year, description },
    id,
  },
} = Astro.props;
---

<a data-astro-prefetch="hover" href={`/portfolio/${id}/`} class="dark:bg-gray-800/50 rounded-lg h-full p-4 flex flex-col border-subtle-light dark:border-subtle-dark border dark:hover:bg-gray-800 hover:bg-gray-100 transition-colors duration-300">
  <Image
    loading="eager"
    densities={[1, 2, 3]}
    quality="high"
    alt={title}
    src={image}
    class="rounded-md w-full h-[150px] object-cover object-top pointer-events-none"
  />
  <div class="title flex flex-col gap-1 mt-4 flex-grow">
    <span class="yr text-subtle dark:text-subtle-dark text-xs m-0 font-medium tracking-widest ml-1">{year}</span>
    <h3 class="font-medium ml-1">{title}</h3>
    <div class="roles flex flex-row justify-start items-center gap-2 mt-4">
      {
        roles.map((role) => (
          <Pill size="sm" variant="outlined">
            {role}
          </Pill>
        ))
      }
    </div>
  </div>
</a>

<style lang="postcss">
  @reference "../styles/global.css";

  a {
  }     
</style>
