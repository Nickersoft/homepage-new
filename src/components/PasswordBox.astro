---
import Button from "./Button.astro";

import Lock from "~icons/mdi/lock";
---

<form class="bg-gray-0 dark:bg-gray-800 z-50 relative dark:border-subtle-dark border-subtle-light border-t p-4 absolute bottom-0 w-full rounded-t-2xl lg:rounded-lg" method="POST">
  <h1 class="font-medium mb-1">Password Required</h1>
  <p class="opacity-75 text-sm mr-16">To view this page, you'll need to enter a password.</p>
  <div class="pw rounded-lg dark:bg-gray-800 px-4 py-2 w-full my-4 border border-subtle-light dark:border-subtle-dark transition-all duration-300 ease-in-out dark:bg-gray-700 bg-gray-100 flex flex-row justify-start items-center gap-4 placeholder:text-subtle dark:placeholder:text-subtle-dark">
    <span class="icon text-subtle dark:text-subtle-dark transition-colors duration-300">
      <Lock />
    </span>
    <input class="bg-clear outline-none flex-grow" placeholder="Password" type="password" name="password" required />
  </div>
  <footer class="flex flex-row justify-end items-center">
    <Button variant="secondary" href="/" title="Go back" />
    <Button title="Submit" />
  </footer>
</form>

<style lang="postcss">
  @reference "../styles/global.css";

  @keyframes fallIn {
    0% {
      transform: translateX(-50%) translateY(-50%) scale(0.98);
      opacity: 0;
    }

    100% {
      transform: translateX(-50%) translateY(-50%) scale(1);
      opacity: 1;
    }
  }

  @keyframes pushUp {
    0% {
      transform: translateY(20px);
      opacity: 0;
    }

    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  footer {
  }

  form {
    
    animation: pushUp 0.3s ease-in-out;

    @media (width >= 1024px) {
      @apply border top-1/2 left-1/2 bottom-auto w-auto;

      animation: fallIn 0.3s ease-in-out both;
    }

    h1 {
    }

    p {
    }

    .pw {

      .icon {
      }

      input {
      }

      &:focus-within {
        @apply border-emphasis-light dark:border-emphasis-dark;

        .icon {
          @apply dark:text-dark;
        }
      }
    }
  }
</style>
