---
export type Props = {
  title: string;
  icon?: astroHTML.JSX.Element;
  href?: string;
  variant?: "primary" | "secondary";
  iconPlacement?: "before" | "after";
};

const {
  title,
  icon: Icon,
  href,
  variant = "primary",
  iconPlacement = "before",
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  class="btn inline-flex cursor-pointer flex-row items-center gap-2 rounded-lg px-4 py-2 text-sm no-underline transition-all duration-150 active:scale-[0.99] active:opacity-50"
  class:list={[
    {
      "btn-primary": variant === "primary",
      "btn-secondary": variant === "secondary",
      "!flex-row-reverse": iconPlacement === "after",
    },
  ]}
  href={href}
>
  {Icon && <Icon />}
  <span class="mt-[2px]">{title}</span>
</Tag>
