---
import Typography from "./ui/Typography.astro";

export interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<Typography variant="body" size="md" color="muted">
  <time class="label" datetime={date.toISOString()}>
    {
      date.toLocaleDateString("en-us", {
        year: "numeric",
        month: "short",
        day: "numeric",
      })
    }
  </time>
</Typography>
