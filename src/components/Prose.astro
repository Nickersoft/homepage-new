---
import { cn } from "@/lib/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...props } = Astro.props;
---

<div
  {...props}
  class={cn(
    "prose prose-stone prose-base prose-strong:font-semibold relative prose-figcaption:text-muted-foreground pt-2 prose-code:font-normal prose-p:text-secondary-foreground prose-li:text-secondary-foreground prose-h2:font-semibold prose-blockquote:font-normal prose-figcaption:mt-6 max-w-none w-full prose-headings:font-sans prose-figure:text-center prose-img:shadow-md prose-img:rounded-2xl prose-img:border prose-img:mx-auto",
    className,
  )}
>
  <slot />
</div>
