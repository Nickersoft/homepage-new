---
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

const pillVariants = tv({
  base: [
    "inline-flex text-secondary-foreground flex-row items-center gap-2 rounded-full ",
  ],
  variants: {
    variant: {
      filled: "bg-foreground/7",
      outlined: "border",
    },
    size: {
      sm: "text-xs px-3 py-1.5",
      md: "text-sm px-4 py-2",
    },
  },
  defaultVariants: {
    variant: "filled",
    size: "md",
  },
});

export type Props = HTMLAttributes<"span"> & VariantProps<typeof pillVariants>;

const { variant, size, class: className, ...props } = Astro.props;
---

<span {...props} class={pillVariants({ className, variant, size })}>
  <slot />
</span>
