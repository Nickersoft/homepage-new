---
export type Props = {
  variant?: "filled" | "outlined";
  size?: "sm" | "md";
};

const { variant = "filled", size = "md" } = Astro.props;
---

<span
  class:list={[
    {
      filled: variant === "filled",
      sm: size === "sm",
    },
  ]}
  class="pill border-subtle-light dark:border-subtle-dark inline-flex flex-row items-center gap-2 rounded-full border px-4 py-2 text-sm text-gray-900/75 dark:text-white/75"
  ><slot /></span
>

