---
export type Props = {
  variant?: "filled" | "outlined";
  size?: "sm" | "md";
};

const { variant = "filled", size = "md" } = Astro.props;
---

<span
  class:list={[
    {
      filled: variant === "filled",
      sm: size === "sm",
    },
  ]}
  class="pill inline-flex flex-row items-center gap-2 text-sm px-4 py-2 rounded-full text-gray-900/75 dark:text-white/75 border border-subtle-light dark:border-subtle-dark"><slot /></span
>

<style lang="postcss">
  @reference "../styles/global.css";

  .pill {
    
    &.filled {
      @apply dark:bg-gray-800;
    }

    &.sm {
      @apply text-xs px-3 py-1.5;
    }
  }
</style>
