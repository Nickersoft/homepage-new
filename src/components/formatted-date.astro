---
export interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<time
  class="text-muted-foreground text-xs font-medium tracking-widest uppercase"
  datetime={date.toISOString()}
>
  {
    date.toLocaleDateString("en-us", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  }
</time>
