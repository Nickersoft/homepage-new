---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import { cnBase as cn } from "tailwind-variants";
import me from "../assets/me.png";

export interface Props extends HTMLAttributes<"div"> {
  size?: number;
}

const { size = 96, class: className, ...props } = Astro.props;
---

<div
  {...props}
  style={{ width: `${size}px`, height: `${size}px` }}
  class={cn(
    "rounded-3xl relative shadow-md overflow-hidden ring-1 ring-white/10",
    className,
  )}
>
  <div
    class="absolute inset-0 z-20 inset-shadow-[0_4px_8px] inset-shadow-white/60"
  >
  </div>
  <Image
    src={me}
    width={size}
    height={size}
    layout="constrained"
    alt="Selfie"
    class="size-full object-cover"
  />
</div>
