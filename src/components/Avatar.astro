---
import { Image } from "astro:assets";

import me from "../assets/me.png";

export interface Props {
  width?: number;
  height?: number;
}

const { width = 96, height = 96 } = Astro.props;

const upscaledHeight = height * 3.125;
const upscaledWidth = width * 3.125;
---

<div
  class="relative overflow-hidden rounded-full"
  style={`width: ${width}px; height: ${height}px;`}
>
  <Image
    src={me}
    width={upscaledHeight}
    height={upscaledWidth}
    loading="lazy"
    decoding="async"
    alt="Selfie"
    class="grayscale size-full object-cover"
  />
  <div
    class="absolute inset-0 bg-gradient-to-br from-blue-500 to-purple-500 mix-blend-soft-light"
  >
  </div>
</div>
