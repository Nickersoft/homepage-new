---
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

const pillVariants = tv({
  base: [
    "inline-flex px-3 py-1.5 text-secondary-foreground font-medium text-xs flex-row items-center gap-2 rounded-full ",
  ],
  variants: {
    variant: {
      filled: "bg-foreground/7",
      outlined: "border",
    },
  },
  defaultVariants: {
    variant: "filled",
  },
});

export type Props = HTMLAttributes<"span"> & VariantProps<typeof pillVariants>;

const { variant, class: className, ...props } = Astro.props;
---

<span {...props} class={pillVariants({ className, variant })}>
  <slot />
</span>
