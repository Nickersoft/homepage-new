---
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

const buttonVariants = tv({
  base: [
    "inline-flex gap-2 flex-row items-center text-sm px-4 py-2 rounded-full",
    "active:scale-99 transition-all duration-300 ease-out active:opacity-50 cursor-pointer",
    "no-underline cursor-pointer",
  ],
  variants: {
    variant: {
      primary:
        "hover:shadow-md hover:scale-103 bg-primary text-primary-foreground hover:bg-primary/90",
      secondary:
        "text-secondary-foreground bg-secondary hover:text-secondary-foreground/90",
    },
  },
  defaultVariants: {
    variant: "primary",
  },
});

export type Props = (HTMLAttributes<"a"> | HTMLAttributes<"button">) &
  VariantProps<typeof buttonVariants>;

const { class: className, variant, ...props } = Astro.props;

const Tag = "href" in Astro.props ? "a" : "button";
---

<Tag {...props as any} class={buttonVariants({ className, variant })}>
  <slot />
</Tag>
