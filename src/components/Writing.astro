---
import { getCollection } from "astro:content";

import FormattedDate from "@/components/formatted-date.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<ul class="grid w-full grid-cols-2 py-4">
  {
    posts.map((post) => (
      <li class="group col-span-2 w-full py-3">
        <a
          data-astro-prefetch="hover"
          href={`/blog/${post.id}/`}
          class="group-hover:text-primary flex! w-full flex-col gap-1 font-sans text-lg font-normal no-underline transition-all duration-250 ease-out group-hover:font-[450]"
        >
          <FormattedDate date={post.data.pubDate} />
          <span>{post.data.title}</span>
        </a>
      </li>
    ))
  }
</ul>
