---
import { getCollection } from "astro:content";

import FormattedDate from "@/components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<div>
  <h2>Writing</h2>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a
            class="text-lg font-sans font-normal mb-0 mt-1 py-4 rounded-lg px-4 flex flex-col gap-1 transition-all duration-300 -mx-4 hover:dark:bg-gray-800 hover:bg-gray-100 active:opacity-50"
            data-astro-prefetch="hover"
            href={`/blog/${post.slug}/`}
          >
            <FormattedDate date={post.data.pubDate} />
            {post.data.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>
